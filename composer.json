{
  "name": "golpilolz/csv-om",
  "type": "symfony-bundle",
  "description": "Object manager for CSV files",
  "keywords": ["bundle", "symfony", "csv", "object-manager"],
  "license": "MIT",
  "authors": [
    {
      "name": "Golpilolz and other contributors",
      "homepage": "https://github.com/golpilolz/csv-om/graphs/contributors"
    }
  ],
  "require": {
    "php": ">=8.3",
    "psr/container": "^1.1 | ^2.0",
    "league/csv": "^9.28",
    "symfony/config": "^7.4 | ^8",
    "symfony/dependency-injection": "^7.4 | ^8",
    "symfony/http-kernel": "^7.4 | ^8",
    "symfony/yaml": "^7.4 | ^8"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "rector/rector": "^2.8",
    "symfony/maker-bundle": "^1.60",
    "symfony/string": "^7.4 | ^8"
  },
  "suggest": {
    "symfony/maker-bundle": "Enables the make:csv-entity command"
  },
  "autoload": {
    "psr-4": {
      "Golpilolz\\CsvOm\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Golpilolz\\CsvOm\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "rector": "rector process --dry-run",
    "rector:fix": "rector process"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.3.0"
    }
  }
}
