{
  "name": "golpilolz/csv-om",
  "type": "symfony-bundle",
  "description": "Object manager for CSV files",
  "keywords": ["bundle", "symfony", "csv", "object-manager"],
  "license": "MIT",
  "authors": [
    {
      "name": "Golpilolz and other contributors",
      "homepage": "https://github.com/golpilolz/csv-om/graphs/contributors"
    }
  ],
  "require": {
    "php": ">=8.3",
    "league/csv": "^9.28",
    "symfony/config": "^6.4 | ^7.0",
    "symfony/dependency-injection": "^6.4 | ^7.0",
    "symfony/http-kernel": "^6.4 | ^7.0",
    "symfony/yaml": "^6.4 | ^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Golpilolz\\CsvOm\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Golpilolz\\CsvOm\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.3.0"
    }
  }
}
